[Unit]
Description=Voxtype On-Device Voice Transcription Daemon
Requires=dotoold.service ydotoold.service
After=default.target dotoold.service ydotoold.service

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/voxtype daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
