# Editors
alias n='nvim'

# SSH
alias sm='ssh main'

# Version control
alias g='git'
alias gc='git add -u && git commit -m "chore: update $(git diff --cached --name-only | head -n1)"'
alias gcp='git add -u && git commit -m "chore: update $(git diff --cached --name-only | head -n1)" && git push'
alias gp='git push'
alias gl='git pull'
alias lg='lazygit'
alias j='jj'
alias ji='jjui'
alias jd='jj diff'

# Diff tools
alias h='hunk'

# Agent harnesses
alias cl='claude'
alias co='codex'

# Obsidian
alias vault='cd ~/Documents/Obsidian/ && nvim'

# Files
alias la='ls -a'

# Chezmoi
alias cz='chezmoi'
alias czd='cd $(chezmoi source-path)'
alias cza='chezmoi apply --force'

# bun completions
[ -s "~/.bun/_bun" ] && source "~/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
