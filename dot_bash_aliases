# Agent harnesses
alias cl='claude'
alias co='codex'

# Multiplexer clients can be remote even when their panes lack SSH variables.
# Send copies through the terminal in Rex and Herdr, including local panes.
pi() {
  if [ "${HERDR_ENV:-}" = 1 ] || [ -n "${REX_SESSION:-}" ]; then
    PI_CLIPBOARD_OSC52=1 command pi "$@"
  else
    command pi "$@"
  fi
}

