alias n='nvim'

# SSH
fwd() {
  if [ "$#" -ne 1 ]; then
    printf 'Usage: fwd <port>\n' >&2
    return 2
  fi
  ssh -N -o ExitOnForwardFailure=yes \
    -L "127.0.0.1:${1}:localhost:${1}" eddie@mac
}

alias sd='ssh desktop'
alias sm="ssh mac 'herdr; exec \"\$SHELL\" -l'"
alias mm="mosh mac -- sh -c 'herdr; exec \"\$SHELL\" -l'"

# Version control
wt() {
  if [ "${1:-}" != new ] && [ "${1:-}" != cd ]; then
    command wt "$@"
    return $?
  fi
  local argument destination
  for argument in "$@"; do
    case "$argument" in
      -h*|--h|--he|--hel|--help)
        command wt "$@"
        return $?
        ;;
    esac
  done
  # Preserve trailing newlines in existing checkout paths during command substitution.
  destination=$(command wt "$@" && printf '.') || return $?
  destination=${destination%.}
  destination=${destination%$'\n'}
  builtin cd -- "$destination" || return $?
  if [ "${HERDR_ENV:-}" = 1 ] || [ -n "${REX_SESSION:-}" ]; then
    command wt _rename-tab >/dev/null 2>&1 || :
  fi
  return 0
}

_wt_complete() {
  COMPREPLY=()
  if [ "${COMP_CWORD:-0}" -eq 2 ] && [ "${COMP_WORDS[1]:-}" = cd ]; then
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local branches branch
    branches=$(command wt _complete cd 2>/dev/null) || return 0
    while IFS= read -r branch; do
      [ -n "$branch" ] || continue
      case "$branch" in
        "$cur"*) COMPREPLY+=("$branch") ;;
      esac
    done <<< "$branches"
  fi
}

_wt_zsh_complete() {
  if [ "${CURRENT:-0}" -eq 3 ] && [ "${words[2]:-}" = cd ]; then
    local branches branch
    local -a candidates
    branches=$(command wt _complete cd 2>/dev/null) || return 0
    candidates=()
    while IFS= read -r branch; do
      [ -n "$branch" ] && candidates+=("$branch")
    done <<< "$branches"
    [ "${#candidates[@]}" -gt 0 ] && compadd -a -- candidates
  fi
}

if [ -n "${BASH_VERSION:-}" ]; then
  complete -F _wt_complete wt
elif [ -n "${ZSH_VERSION:-}" ] && typeset -f compdef >/dev/null 2>&1; then
  compdef _wt_zsh_complete wt
fi

