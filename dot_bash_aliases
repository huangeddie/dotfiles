# Editors
alias n='nvim'

# SSH
fwd() {
  if [ "$#" -ne 1 ]; then
    printf 'Usage: fwd <port>\n' >&2
    return 2
  fi
  ssh -N -o ExitOnForwardFailure=yes \
    -L "127.0.0.1:${1}:localhost:${1}" eddie@mac
}

alias sd='ssh desktop'
alias sm="ssh mac 'herdr; exec \"\$SHELL\" -l'"
alias mm="mosh mac -- sh -c 'herdr; exec \"\$SHELL\" -l'"

# Version control
alias g='git'
alias gc='git add -u && git commit -m "chore: update $(git diff --cached --name-only | head -n1)"'
alias gcp='git add -u && git commit -m "chore: update $(git diff --cached --name-only | head -n1)" && git push'
alias gp='git push'
alias gl='git pull'
alias lg='lazygit'
alias j='jj'
alias ji='jjui'
alias jd='jj diff'

# Diff tools
alias h='hunk'
alias hs='hunk show'
alias hd='hunk diff'

# Agent harnesses
alias cl='claude'
alias co='codex'

# Multiplexer clients can be remote even when their panes lack SSH variables.
# Send copies through the terminal in Rex and Herdr, including local panes.
pi() {
  if [ "${HERDR_ENV:-}" = 1 ] || [ -n "${REX_SESSION:-}" ]; then
    PI_CLIPBOARD_OSC52=1 command pi "$@"
  else
    command pi "$@"
  fi
}

