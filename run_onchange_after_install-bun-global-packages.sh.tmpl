{{ template "validate-machine-package-data.tmpl" . }}
{{- $root := . -}}
{{- $packagePolicy := get $root "packagePolicy" | default dict -}}
{{- $newDenied := get $packagePolicy "deniedPrefixes" | default list -}}
{{- $legacyDenied := get $root "blocked_prefixes" | default list -}}
{{- $deniedPrefixes := concat $newDenied $legacyDenied | uniq -}}
{{- $bunRoles := $root.packages.bun.global.roles -}}
{{- if not (kindIs "map" $bunRoles) }}{{ fail "packages.bun.global.roles must be a map" }}{{ end -}}
{{- $knownRoles := list -}}
{{- range $_, $platformRoles := $root.machineRolePolicy.platforms -}}
  {{- range $role := $platformRoles -}}
    {{- $knownRoles = append $knownRoles $role -}}
  {{- end -}}
{{- end -}}
{{- $bunPackageOwners := dict -}}
{{- range $role, $rolePackages := $bunRoles -}}
  {{- if not (has $role $knownRoles) }}{{ fail (printf "packages.bun.global.roles contains unknown role %q" $role) }}{{ end -}}
  {{- if not (kindIs "slice" $rolePackages) }}{{ fail (printf "packages.bun.global.roles.%s must be a list" $role) }}{{ end -}}
  {{- $seenRolePackages := dict -}}
  {{- range $index, $package := $rolePackages -}}
    {{- if or (not (kindIs "string" $package)) (empty ($package | trim)) }}{{ fail (printf "packages.bun.global.roles.%s[%d] must be a non-empty string" $role $index) }}{{ end -}}
    {{- if ne $package ($package | trim) }}{{ fail (printf "packages.bun.global.roles.%s[%d] must not have leading or trailing whitespace" $role $index) }}{{ end -}}
    {{- if hasKey $seenRolePackages $package }}{{ fail (printf "packages.bun.global.roles.%s contains duplicate package %q" $role $package) }}{{ end -}}
    {{- if hasKey $bunPackageOwners $package }}{{ fail (printf "bun global package %q belongs to both roles %q and %q" $package (get $bunPackageOwners $package) $role) }}{{ end -}}
    {{- $_ := set $seenRolePackages $package true -}}
    {{- $_ := set $bunPackageOwners $package $role -}}
  {{- end -}}
{{- end -}}
#!/bin/bash
set -euo pipefail

bun_install=${BUN_INSTALL:-$HOME/.bun}
export BUN_INSTALL="$bun_install"
export PATH="$BUN_INSTALL/bin:$PATH"

if ! command -v bun >/dev/null 2>&1; then
  echo "bun not found after OS package provisioning" >&2
  exit 1
fi

desired_packages=(
{{- range $role := $root.machineRoles }}
  {{- range $package := (get $bunRoles $role | default list) }}
    {{- $denied := false -}}
    {{- range $prefix := $deniedPrefixes }}
      {{- if hasPrefix $prefix $package }}{{ $denied = true }}{{ end -}}
    {{- end -}}
    {{- if not $denied }}
  {{ $package | quote }}
    {{- end -}}
  {{- end -}}
{{- end }}
)

is_desired_package() {
  local candidate=$1
  local package

  if (( ${#desired_packages[@]} == 0 )); then
    return 1
  fi

  for package in "${desired_packages[@]}"; do
    if [[ "$candidate" == "$package" ]]; then
      return 0
    fi
  done

  return 1
}

global_manifest=$BUN_INSTALL/install/global/package.json
current_packages=()
if [[ -f "$global_manifest" ]]; then
  current_package_output=$(bun -e '
    const { readFileSync } = require("node:fs");
    const manifest = JSON.parse(readFileSync(process.argv[1], "utf8"));
    const dependencies = manifest.dependencies ?? {};
    if (dependencies === null || typeof dependencies !== "object" || Array.isArray(dependencies)) {
      throw new Error("global package.json dependencies must be an object");
    }
    for (const name of Object.keys(dependencies).sort()) {
      console.log(name);
    }
  ' "$global_manifest")

  while IFS= read -r package; do
    if [[ -n "$package" ]]; then
      current_packages+=("$package")
    fi
  done <<<"$current_package_output"
fi

desired_specs=()
if (( ${#desired_packages[@]} > 0 )); then
  for package in "${desired_packages[@]}"; do
    desired_specs+=("$package@latest")
  done
  bun add --global "${desired_specs[@]}"
fi

packages_to_remove=()
if (( ${#current_packages[@]} > 0 )); then
  for package in "${current_packages[@]}"; do
    if ! is_desired_package "$package"; then
      packages_to_remove+=("$package")
    fi
  done
fi

if (( ${#packages_to_remove[@]} > 0 )); then
  bun remove --global "${packages_to_remove[@]}"
fi
