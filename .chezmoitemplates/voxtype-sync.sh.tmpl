{{- /*
  Renders a Voxtype sync script: downloads the selected model and, on Linux,
  restarts the systemd user services. Shared by every chezmoi layer.

  Input (dict):
    config   - effective Voxtype config.toml contents (TOML string)
    os       - target OS, usually .chezmoi.os
    triggers - map of input name -> contents; each is hashed into the script so
               the caller's run_onchange_ script re-runs when any input changes
*/ -}}
{{- $config := .config | fromToml -}}
{{- $engine := get $config "engine" | default "whisper" -}}
{{- $section := get $config $engine -}}
{{- $model := "" -}}
{{- if kindIs "map" $section -}}{{- $model = get $section "model" | default "" -}}{{- end -}}
#!/bin/bash

# Re-runs whenever these inputs change:
{{- range $name, $contents := .triggers }}
#   {{ $name }}: {{ $contents | sha256sum }}
{{- end }}

set -euo pipefail

VOXTYPE_BIN="$HOME/.local/bin/voxtype"
if command -v voxtype >/dev/null 2>&1; then
  VOXTYPE_CMD="voxtype"
elif [[ -x "$VOXTYPE_BIN" ]]; then
  VOXTYPE_CMD="$VOXTYPE_BIN"
else
  VOXTYPE_CMD=""
fi

CONFIG_FILE="$HOME/.config/voxtype/config.toml"

if [[ -n "$VOXTYPE_CMD" && -f "$CONFIG_FILE" ]]; then
  model={{ $model | replace "'" "'\\''" | printf "'%s'" }}
  if [[ -n "$model" ]]; then
    echo "🎙️ Ensuring Voxtype model '$model' is downloaded..."
    "$VOXTYPE_CMD" setup --download --model "$model" --no-post-install
  fi
fi

{{ if eq .os "linux" -}}
if command -v systemctl >/dev/null 2>&1 && [[ -n "$VOXTYPE_CMD" && -x "$HOME/.local/bin/dotoold" ]]; then
  echo "🔄 Reloading and restarting dotoold and voxtype user services..."
  systemctl --user daemon-reload
  systemctl --user enable --now dotoold.service voxtype.service
  systemctl --user restart voxtype.service
fi
{{ end -}}
