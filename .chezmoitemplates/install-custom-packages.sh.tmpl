{{- $installers := . -}}
{{- $deniedPrefixes := list -}}
{{- if kindIs "map" . -}}
{{-   $installers = get . "custom" -}}
{{-   $newDeniedPrefixes := get . "denied_prefixes" | default list -}}
{{-   $legacyDeniedPrefixes := get . "blocked_prefixes" | default list -}}
{{-   if not (kindIs "slice" $newDeniedPrefixes) }}{{ fail "custom installers: denied prefixes must be a list" }}{{ end -}}
{{-   if not (kindIs "slice" $legacyDeniedPrefixes) }}{{ fail "custom installers: denied prefixes must be a list" }}{{ end -}}
{{-   $deniedPrefixes = concat $newDeniedPrefixes $legacyDeniedPrefixes | uniq -}}
{{- end -}}
{{- if not (kindIs "slice" $deniedPrefixes) }}{{ fail "custom installers: denied prefixes must be a list" }}{{ end -}}
{{ template "validate-custom-installers.tmpl" $installers }}
{{- range $installer := $installers }}
{{- $name := get $installer "name" -}}
{{- $executable := get $installer "executable" -}}
{{- $setup := get $installer "setup" -}}
{{- $install := get $installer "install" -}}
{{- $quotedName := $name | replace "'" "'\"'\"'" -}}
{{- $denied := false -}}
{{- range $prefix := $deniedPrefixes -}}
{{-   if hasPrefix $prefix $name -}}
{{-     $denied = true -}}
{{-   end -}}
{{- end -}}
{{- if $denied }}
echo '🚫 Skipping {{ $quotedName }} (denied prefix)'
{{- else }}
{{ with $setup -}}
{{ . }}
{{ end -}}
if ! command -v '{{ $executable }}' >/dev/null 2>&1; then
  printf '🚀 Installing %s...\n' '{{ $quotedName }}'
{{ $install | indent 2 }}
fi
{{- end }}
{{- end }}
