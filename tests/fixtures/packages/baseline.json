  "linux-base": {
    "apt": {
      "install": [
        "bat",
        "btop",
        "curl",
        "fd-find",
        "ffmpeg",
        "fzf",
        "gh",
        "ghostty",
        "git",
        "git-delta",
        "golang-go",
        "libxkbcommon-dev",
        "neovim",
        "nodejs",
        "npm",
        "nvtop",
        "openssh-server",
        "pipewire-alsa",
        "ripgrep",
        "wl-clipboard"
      ],
      "remove": [
        "lazygit",
        "steam-devices",
        "steam-installer"
      ]
    },
    "bun": [
      "@doist/todoist-cli",
      "@earendil-works/pi-coding-agent",
      "hunkdiff",
      "prettier"
    ],
    "custom": [
      {
        "executable": "tv",
        "install": "curl -fsSL https://alexpasmantier.github.io/television/install.sh | bash",
        "name": "television"
      },
      {
        "executable": "zoxide",
        "install": "curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh",
        "name": "zoxide"
      },
      {
        "executable": "herdr",
        "install": "curl -fsSL https://herdr.dev/install.sh | sh",
        "name": "herdr"
      },
      {
        "executable": "tailscale",
        "install": "curl -fsSL https://tailscale.com/install.sh | sh",
        "name": "tailscale"
      },
      {
        "executable": "bun",
        "install": "curl -fsSL https://bun.com/install | bash",
        "name": "bun"
      },
      {
        "executable": "cargo",
        "install": "curl https://sh.rustup.rs -sSf | sh",
        "name": "cargo"
      },
      {
        "executable": "lazygit",
        "install": "go install github.com/jesseduffield/lazygit@latest",
        "name": "lazygit",
        "setup": "export GOPATH=\"${GOPATH:-$HOME/.local/share/go}\"\nexport PATH=\"$GOPATH/bin:$PATH\""
      },
      {
        "executable": "dotool",
        "install": "DOTOOL_TMP=$(mktemp -d)\ntrap 'rm -rf \"$DOTOOL_TMP\"' EXIT\ngit clone --depth 1 https://git.sr.ht/~geb/dotool \"$DOTOOL_TMP\"\nmkdir -p \"$DOTOOL_TMP/build\"\n(cd \"$DOTOOL_TMP/build\" && cmake -DCMAKE_BUILD_TYPE=Release .. && make -j\"$(nproc)\")\nmkdir -p ~/.local/bin\ninstall -m 755 \"$DOTOOL_TMP/build/dotool\" ~/.local/bin/dotool\ninstall -m 755 \"$DOTOOL_TMP/build/dotoolc\" ~/.local/bin/dotoolc\ninstall -m 755 \"$DOTOOL_TMP/dotoold\" ~/.local/bin/dotoold",
        "name": "dotool"
      },
      {
        "executable": "voxtype",
        "install": "mkdir -p ~/.local/bin ~/.local/share/voxtype/models\nVOXTYPE_VERSION=\"1.1.0\"\nif grep -q \"avx512\" /proc/cpuinfo 2>/dev/null; then\n  VARIANT=\"onnx-avx512\"\nelse\n  VARIANT=\"onnx-avx2\"\nfi\nVOXTYPE_URL=\"https://github.com/peteonrails/voxtype/releases/download/v${VOXTYPE_VERSION}/voxtype-${VOXTYPE_VERSION}-linux-x86_64-${VARIANT}\"\ncurl -fsSL \"$VOXTYPE_URL\" -o ~/.local/bin/voxtype\nchmod 755 ~/.local/bin/voxtype\n~/.local/bin/voxtype setup --download --model \"parakeet-tdt-0.6b-v3-int8\" --no-post-install",
        "name": "voxtype"
      }
    ],
    "homebrew": {
      "brews": [],
      "casks": [],
      "taps": [],
      "trustedFormulae": []
    }
  },
