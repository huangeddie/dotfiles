#!/bin/sh
set -eu
app="${XDG_CONFIG_HOME:-$HOME/.config}/grain"
command -v bun >/dev/null 2>&1 || { echo 'grain requires Bun >=1.3.0' >&2; exit 1; }
[ -f "$app/main.ts" ] || { echo 'grain app is missing; apply its chezmoi files.' >&2; exit 1; }
# Help does not need scc, OpenTUI, or a terminal. main.ts still validates the arguments.
for arg do
  [ "$arg" != '--' ] || break
  if [ "$arg" = '--help' ]; then exec bun --no-install "$app/main.ts" "$@"; fi
done
command -v scc >/dev/null 2>&1 || { echo 'grain requires scc' >&2; exit 1; }
[ -d "$app/node_modules/@opentui/core" ] || {
  echo 'grain dependencies are missing; apply the chezmoi dependency installer.' >&2
  exit 1
}
exec bun --no-install "$app/main.ts" "$@"
