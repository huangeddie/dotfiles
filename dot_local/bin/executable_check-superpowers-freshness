#!/bin/bash
# Checks whether the vendored superpowers skills (pulled via .chezmoiexternal.toml)
# match the latest commit on the upstream branch, without relying on chezmoi's
# archive cache to expose a commit hash. Manual/QA-style: not run in CI.
set -euo pipefail

external_key=".agents/packages/superpowers/skills"

source_dir="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}"
home_dir="${CHEZMOI_HOME_DIR:-$(chezmoi data | jq -r '.chezmoi.homeDir')}"
target_dir="$home_dir/$external_key"

url=""
external_toml=""
while IFS= read -r -d '' candidate; do
  extracted_url=$(awk -v key="[\"$external_key\"]" '
    $0 == key { in_block = 1; next }
    in_block && /^\[/ { exit }
    in_block && /^[ \t]*url[ \t]*=/ { gsub(/.*url[ \t]*=[ \t]*"|"[ \t]*$/, ""); print; exit }
  ' "$candidate")
  if [[ -n "$extracted_url" ]]; then
    url="$extracted_url"
    external_toml="$candidate"
    break
  fi
done < <(find "$source_dir" -name ".git" -prune -o -name ".chezmoiexternal.toml" -type f -print0)

if [[ -z "$url" ]]; then
  echo "Could not find url for [\"$external_key\"] in any .chezmoiexternal.toml under $source_dir" >&2
  exit 1
fi

if [[ ! "$url" =~ ^https://github\.com/([^/]+)/([^/]+)/archive/refs/heads/([^/]+)\.tar\.gz$ ]]; then
  echo "Unrecognized archive url format: $url" >&2
  exit 1
fi
owner="${BASH_REMATCH[1]}"
repo="${BASH_REMATCH[2]}"
branch="${BASH_REMATCH[3]}"

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

git clone --quiet --depth 1 --branch "$branch" --single-branch "https://github.com/$owner/$repo.git" "$tmp_dir/repo" || {
  echo "Could not clone $owner/$repo@$branch from https://github.com/$owner/$repo.git" >&2
  exit 1
}

latest_sha=$(git -C "$tmp_dir/repo" rev-parse HEAD)
if [[ -z "$latest_sha" ]]; then
  echo "Could not resolve latest commit for $owner/$repo@$branch" >&2
  exit 1
fi

if [[ -d "$tmp_dir/repo/skills" ]]; then
  extracted_skills="$tmp_dir/repo/skills"
else
  extracted_skills=$(find "$tmp_dir/repo" -mindepth 1 -maxdepth 2 -type d -name skills | head -1)
fi

if [[ -z "$extracted_skills" ]]; then
  echo "Cloned repository has no skills/ directory" >&2
  exit 1
fi

if [[ ! -d "$target_dir" ]]; then
  echo "✗ $target_dir does not exist locally — run: chezmoi apply" >&2
  exit 1
fi

if diff -rq "$extracted_skills" "$target_dir" >/dev/null; then
  echo "✓ superpowers skills are up to date with $owner/$repo@$branch (${latest_sha:0:7})"
else
  echo "✗ superpowers skills are stale against $owner/$repo@$branch (${latest_sha:0:7})"
  echo
  diff -rq "$extracted_skills" "$target_dir" || true
  echo
  echo "Fix: chezmoi apply --refresh-externals"
  exit 1
fi
