#!/usr/bin/env python3
"""Temporary Git worktrees. See docs/wt.md in the chezmoi source."""
import argparse
from dataclasses import dataclass
from graphlib import CycleError, TopologicalSorter
import json
import os
from pathlib import Path
import subprocess
import sys


@dataclass
class Checkout:
    path: str
    branch: str = ""
    locked: bool = False
    prunable: bool = False


class Worktrees:
    def __init__(self, repository):
        self.repo = repository

    def list(self):
        return "\n".join(f"{c.branch or '(detached)'}\t{c.path}" for c in self.repo.worktrees())

    def path(self, branch):
        if not branch or not self.repo.has_branch(branch):
            raise ValueError(f"No local branch named {branch!r}.")
        matches = [c for c in self.repo.worktrees() if c.branch == branch]
        if not matches:
            raise ValueError(f"Branch {branch!r} is not checked out in any worktree.")
        if len(matches) != 1:
            raise ValueError(f"Branch {branch!r} is checked out in multiple worktrees; navigate by path.")
        checkout = matches[0]
        if checkout.prunable or not self.repo.is_directory(checkout.path):
            raise ValueError(f"Worktree for {branch!r} is missing or unavailable: {checkout.path}")
        return checkout.path

    def title(self):
        branch = self.repo.current_branch()
        record = self.repo.records().get(branch)
        name = record.get("name") if isinstance(record, dict) else None
        return name if isinstance(name, str) and name else branch

    def new(self, name, base=None):
        branch = "-".join(name.lower().split())
        base = base if base is not None else self.repo.current_branch()
        if not base:
            raise ValueError("Detached HEAD: supply --base with a local branch.")
        if not self.repo.valid_branch(branch) or self.repo.has_branch(branch):
            raise ValueError("Choose a valid, new branch name.")
        if not self.repo.has_branch(base):
            raise ValueError(f"Missing local base branch: {base}")
        return self.repo.create(branch, base, name)

    def managed(self, branch, clearing=()):
        branch = branch or self.repo.current_branch()
        records = self.repo.records()
        record = records.get(branch)
        if (not isinstance(record, dict) or set(record) not in ({"base", "path"}, {"base", "path", "name"})
                or not all(isinstance(v, str) and v for v in record.values())
                or record["base"] == branch):
            raise ValueError(f"Not a valid wt-managed branch: {branch or '(detached)'}")
        checkouts = self.repo.worktrees()
        matches = [c for c in checkouts if c.branch == branch]
        if len(matches) != 1 or matches[0] == checkouts[0]:
            raise ValueError("Only a managed linked worktree can be removed.")
        checkout = matches[0]
        path = Path(record["path"])
        if (checkout.path != str(path) or not path.is_absolute()
                or not (path.name.startswith("wt-")
                        or (path.name == "repo" and path.parent.name.startswith("wt-")))
                or ".." in path.parts or checkout.locked or checkout.prunable):
            raise ValueError("Sandbox path mismatch, locked, or missing worktree; repair it manually.")
        children = [name for name, value in records.items()
                    if name not in clearing and isinstance(value, dict) and value.get("base") == branch]
        if children:
            raise ValueError(f"Branch is still a base for: {', '.join(children)}")
        self.repo.validate_sandbox(checkout.path)
        return branch, record, checkout

    def clean(self, checkout):
        if self.repo.dirty(checkout.path) or self.repo.busy(checkout.path):
            raise ValueError(f"A clean checkout with no operation in progress is required: {checkout.path}")

    def merge(self, branch=None):
        branch, record, source = self.managed(branch)
        self.clean(source)
        base = record["base"]
        if not self.repo.has_branch(base):
            raise ValueError(f"Missing local base branch: {base}")
        targets = [c for c in self.repo.worktrees() if c.branch == base and not c.prunable]
        if len(targets) != 1:
            raise ValueError(f"Base branch must be checked out exactly once: {base}")
        target = targets[0]
        self.clean(target)
        self.repo.merge(target.path, branch)
        # Recheck merge ancestry and source state before destructive cleanup.
        self.remove(branch)
        return target.path

    def clear(self, force=False):
        names = set(self.repo.records())
        # Preflight every candidate before any deletion, including children in this batch.
        candidates = {name: self.validate_removal(name, force, clearing=names) for name in sorted(names)}
        dependencies = {name: [] for name in candidates}
        for name, (_, record, _) in candidates.items():
            if record["base"] in dependencies:
                dependencies[record["base"]].append(name)
        try:
            order = tuple(TopologicalSorter(dependencies).static_order())
        except CycleError as error:
            raise ValueError("Cannot clear cyclic sandbox base relationships; repair metadata first.") from error
        for name in order:
            self.remove(name, force)  # Recheck immediately before each deletion.
        return len(order)

    def validate_removal(self, branch, force, clearing=()):
        branch, record, checkout = self.managed(branch, clearing)
        if not force:
            if not self.repo.has_branch(record["base"]):
                raise ValueError(f"Missing local base branch: {record['base']}")
            if not self.repo.is_ancestor(branch, record["base"]):
                raise ValueError(f"{branch} is not merged into {record['base']}; use --force to discard it.")
            self.clean(checkout)
            if self.repo.has_initialized_submodules(checkout.path):
                raise ValueError(f"Worktree has initialized submodules; use --force to discard them: {checkout.path}")
        return branch, record, checkout

    def remove(self, branch=None, force=False):
        branch, _, checkout = self.validate_removal(branch, force)
        self.repo.delete(branch, checkout.path, force)


def sandbox_name(branch):
    return "wt-" + branch.replace("/", "-")


def sandbox_root(home, environment):
    cache = Path(environment.get("XDG_CACHE_HOME", ""))
    return (cache if cache.is_absolute() else home / ".cache") / "wt"


def parse_worktrees(output):
    checkouts = []
    for block in output.split("\0\0"):
        if not block:
            continue
        fields = dict(field.partition(" ")[::2] for field in block.split("\0") if field)
        checkouts.append(Checkout(
            fields["worktree"], fields.get("branch", "").removeprefix("refs/heads/"),
            "locked" in fields, "prunable" in fields))
    return checkouts


class GitRepository:
    """Effect boundary: subprocesses, local Git metadata, and sandbox directories."""

    def __init__(self):
        self.anchor = os.getcwd()
        self.invocation = self.anchor
        # Keep Git commands usable even after deleting the invoking worktree.
        checkouts = self.worktrees()
        if not checkouts or not Path(checkouts[0].path).is_dir():
            raise ValueError("The original repository checkout must exist.")
        self.anchor = checkouts[0].path

    def git(self, *args, path=None, allowed=(0,)):
        result = subprocess.run(["git", *args], cwd=path or self.anchor, capture_output=True)
        # Git paths are filesystem bytes: text=True would normalize CR/CRLF to LF.
        result.stdout = os.fsdecode(result.stdout)
        result.stderr = os.fsdecode(result.stderr)
        if result.returncode not in allowed:
            detail = result.stderr.strip() or result.stdout.strip()
            raise RuntimeError(f"git {' '.join(args)} failed ({result.returncode}):\n{detail}")
        return result

    def current_branch(self):
        result = self.git("symbolic-ref", "--quiet", "HEAD", path=self.invocation, allowed=(0, 1))
        return result.stdout.rstrip("\n").removeprefix("refs/heads/")

    def valid_branch(self, branch):
        result = self.git("check-ref-format", "--branch", branch, allowed=(0, 128))
        return result.returncode == 0 and result.stdout.rstrip("\n") == branch

    def has_branch(self, branch):
        return self.git("show-ref", "--verify", "--quiet", f"refs/heads/{branch}",
                        allowed=(0, 1)).returncode == 0

    def worktrees(self):
        return parse_worktrees(self.git("worktree", "list", "--porcelain", "-z").stdout)

    def is_directory(self, path):
        return Path(path).is_dir()

    def records(self):
        result = self.git("config", "--local", "--null", "--get-regexp", r"^branch\..*\.wt$",
                          allowed=(0, 1))
        records = {}
        for item in result.stdout.split("\0"):
            if item:
                key, value = item.split("\n", 1)
                branch = key[len("branch."):-len(".wt")]
                if branch in records:
                    raise ValueError(f"Duplicate wt metadata for {branch}; repair local Git config.")
                records[branch] = json.loads(value)
        return records

    def dirty(self, path):
        return bool(self.git("status", "--porcelain", "--untracked-files=all",
                             "--ignore-submodules=none", path=path).stdout)

    def has_initialized_submodules(self, path):
        status = self.git("submodule", "status", path=path).stdout
        return any(line and not line.startswith("-") for line in status.splitlines())

    def busy(self, path):
        for name in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge",
                     "rebase-apply", "sequencer", "BISECT_START"):
            value = self.git("rev-parse", "--git-path", name, path=path).stdout.rstrip("\n")
            if (Path(path) / value).exists():
                return True
        return False

    def is_ancestor(self, branch, base):
        return self.git("merge-base", "--is-ancestor", f"refs/heads/{branch}",
                        f"refs/heads/{base}", allowed=(0, 1)).returncode == 0

    def create(self, branch, base, name):
        cache = sandbox_root(Path.home(), os.environ)
        cache.mkdir(mode=0o700, parents=True, exist_ok=True)
        info = cache.stat()
        if cache.is_symlink() or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError(f"Sandbox root must be a private, user-owned directory (mode 700), not a symlink: {cache}")
        path = cache / sandbox_name(branch)
        try:
            path.mkdir(mode=0o700)
        except FileExistsError as error:
            raise ValueError(f"Sandbox path already exists: {path}") from error
        path = path.resolve()
        try:
            self.git("worktree", "add", "--quiet", "-b", branch, str(path), f"refs/heads/{base}")
        except Exception:
            # Never recursively delete after partial Git/hook failure.
            if path.is_dir() and not any(path.iterdir()):
                path.rmdir()
            raise
        record = json.dumps({"base": base, "path": str(path), "name": name})
        try:
            self.git("config", "--local", f"branch.{branch}.wt", record)
        except Exception as error:
            raise RuntimeError(f"Created {path}, but could not record its base. "
                               "Worktree retained; inspect it and repair local Git config.") from error
        return str(path)

    def merge(self, path, branch):
        try:
            result = self.git("merge", "--no-ff", "--no-edit", "-m", f"chore: merge {branch}",
                              f"refs/heads/{branch}", path=path)
        except RuntimeError as error:
            raise RuntimeError(f"{error}\nNothing was cleaned up. Resolve and commit in {path}, "
                               f"then run wt remove {branch}; or abort the merge there.") from error
        if result.stdout:
            print(result.stdout.rstrip(), file=sys.stderr)

    def validate_sandbox(self, path):
        checkout = Path(path)
        if not checkout.is_dir() or checkout.resolve() != checkout or checkout.parent.is_symlink():
            raise ValueError(f"Sandbox path is missing or resolves elsewhere; refusing deletion: {path}")

    def delete(self, branch, path, force):
        self.validate_sandbox(path)
        checkout = Path(path)
        # Git independently checks locks and dirty state during removal.
        self.git("worktree", "remove", *(["--force"] if force else []), path)
        try:
            # Policy already checked ancestry against the recorded base, not Git's upstream.
            self.git("branch", "-D", "--", branch)
        except RuntimeError as error:
            raise RuntimeError(f"{error}\nWorktree removed; branch retained. "
                               f"Inspect it and delete it manually; removed checkout: {checkout}") from error
        if checkout.name != "repo":
            return  # Flat layout: the parent is the shared cache, not a sandbox container.
        try:
            checkout.parent.rmdir()  # Legacy layout: remove only the empty container.
        except OSError as error:
            print(f"Branch/worktree removed; retained sandbox container {checkout.parent}: {error}",
                  file=sys.stderr)


def rename_tab(title, environment, run):
    """Resolve the caller's live tab, never the UI-focused tab. Effects are injected."""
    if not title:
        return
    try:
        if environment.get("HERDR_ENV") == "1":
            # Herdr can resolve inherited pane IDs after a move; inherited tab IDs go stale.
            if not environment.get("HERDR_PANE_ID"):
                return
            response = json.loads(run(["herdr", "pane", "current", "--current"]))
            target = response["result"]["pane"]["tab_id"]
            command = ["herdr", "tab", "rename", "--", target, title]
        else:
            session, block = environment.get("REX_SESSION"), environment.get("REX_BLOCK")
            if not session or not block:
                return
            prefix = ["rex", "--autostart=false", "--timeout", "2s"]
            response = json.loads(run([*prefix, "block", "inspect", "-s", session, block, "--json"]))
            if response["session_id"] != session or response["block"]["block_id"] != block:
                raise ValueError("Rex returned a different caller; tab not renamed.")
            target = response["block"]["window_id"]
            command = [*prefix, "window", "rename", "-s", session, "--", target, title]
    except (KeyError, TypeError, json.JSONDecodeError) as error:
        raise ValueError("Could not resolve the calling pane's tab.") from error
    if not isinstance(target, str) or not target:
        raise ValueError("Multiplexer returned no valid tab ID.")
    run(command)


def run_tab_command(command):
    return subprocess.run(command, check=True, text=True, capture_output=True, timeout=2).stdout


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # Private shell hook: called only after builtin cd succeeds.
    if argv == ["_rename-tab"]:
        rename_tab(Worktrees(GitRepository()).title(), os.environ, run_tab_command)
        return 0
    parser = argparse.ArgumentParser(description="Create, list, navigate, merge, and remove Git worktrees.")
    commands = parser.add_subparsers(dest="command", required=True)
    new = commands.add_parser("new", help="create a sandbox from the current local branch")
    new.add_argument("name", help="display name; branch is lowercased with whitespace replaced by hyphens")
    new.add_argument("--base", help="use another local branch instead")
    commands.add_parser("list", help="list all worktrees in this repository by branch and path")
    cd = commands.add_parser("cd", help="enter an existing branch checkout (print its path without shell integration)")
    cd.add_argument("branch", help="exact local branch name; must already have a worktree")
    merge = commands.add_parser("merge", help="merge into recorded base, then remove sandbox and branch")
    merge.add_argument("branch", nargs="?", help="defaults to the current branch")
    remove = commands.add_parser("remove", help="remove a sandbox whose branch is merged into its base")
    remove.add_argument("branch", nargs="?", help="defaults to the current branch")
    remove.add_argument("--force", action="store_true", help="discard unmerged commits and uncommitted files")
    clear = commands.add_parser("clear", help="remove all managed sandboxes in this repository after preflight")
    clear.add_argument("--force", action="store_true", help="discard unmerged commits and uncommitted files")
    args = parser.parse_args(argv)
    repository = GitRepository()
    worktrees = Worktrees(repository)
    if args.command == "new":
        print(worktrees.new(args.name, args.base))
    elif args.command == "list":
        print(worktrees.list())
    elif args.command == "cd":
        print(worktrees.path(args.branch))
    elif args.command == "clear":
        count = worktrees.clear(args.force)
        print(f"Cleared {count} managed sandboxes. Original checkout: {repository.anchor}", file=sys.stderr)
    elif args.command == "merge":
        target = worktrees.merge(args.branch)
        print(f"Merged and cleaned up. Base checkout: {target}", file=sys.stderr)
    else:
        worktrees.remove(args.branch, args.force)
        print(f"Removed sandbox and branch. Original checkout: {repository.anchor}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"wt: {error}", file=sys.stderr)
        sys.exit(1)
