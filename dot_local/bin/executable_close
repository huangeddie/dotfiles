#!/usr/bin/env python3
"""Close the multiplexer session, terminal, or pane this process runs in."""
import os
import sys


def close_command(environment):
    # Priority: Rex -> Herdr App (herdr-core) -> legacy Herdr.
    # Each active family fails closed if its required target ID is missing.
    session = environment.get("REX_SESSION")
    if session or environment.get("REX_BLOCK"):
        if not session:
            return None
        return ["rex", "--autostart=false", "--timeout", "2s", "kill", "--", session]

    terminal = environment.get("HC_TERMINAL_ID")
    if (
        terminal
        or environment.get("HC_TERMINAL_SOCKET")
        or environment.get("HC_SCOPE")
    ):
        return ["hc", "kill", "--", terminal] if terminal else None

    if environment.get("HERDR_ENV") == "1":
        pane = environment.get("HERDR_PANE_ID")
        return ["herdr", "pane", "close", "--", pane] if pane else None

    return None


def main(environment=os.environ, execute=os.execvp, argv=()):
    if tuple(argv) in (("-h",), ("--help",)):
        print("Usage: close\n\n" + (__doc__ or "").strip())
        return 0
    if argv:
        print("close: takes no arguments (Usage: close)", file=sys.stderr)
        return 2
    command = close_command(environment)
    if command is None:
        print(
            "close: not in a Rex session, Herdr App terminal, or Herdr pane",
            file=sys.stderr,
        )
        return 1
    # Closing ends this process, so hand it over to the multiplexer.
    execute(command[0], command)
    return 0


if __name__ == "__main__":
    sys.exit(main(argv=sys.argv[1:]))
