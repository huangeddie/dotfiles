{{- if eq .chezmoi.os "darwin" -}}
{{- $plan := includeTemplate "resolve-packages.tmpl" . | fromJson -}}
{{- $selectedTaps := $plan.homebrew.taps -}}
{{- $selectedTrustedFormulae := $plan.homebrew.trustedFormulae -}}
{{- $selectedTrustedCasks := $plan.homebrew.trustedCasks -}}
{{- $selectedBrews := $plan.homebrew.brews -}}
{{- $selectedCasks := $plan.homebrew.casks -}}
#!/bin/bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "==> Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Homebrew reads its tap-trust allowlist from $XDG_CONFIG_HOME/homebrew/
# when XDG_CONFIG_HOME is set and ~/.homebrew/ otherwise. This script runs
# under non-login bash, which never sources .bashrc, so set it explicitly to
# match interactive shells -- otherwise the two read different files.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Bundle replaces its trust store from Brewfile declarations before cleanup.
# Declare scoped trust in the Brewfile so it survives throughout the bundle.
# packages.yaml is authoritative: --force-cleanup uninstalls anything
# installed that is not declared there.
echo "==> Syncing Homebrew packages via brew bundle (strict)"
brew bundle install --file=/dev/stdin --force-cleanup <<EOF
{{- range $tap := $selectedTaps }}
tap {{ $tap | quote }}
{{- end }}
{{- range $brew := $selectedBrews }}
brew {{ $brew | quote }}{{ if has $brew $selectedTrustedFormulae }}, trusted: true{{ end }}
{{- end }}
{{- range $cask := $selectedCasks }}
{{- $trustedName := "" -}}
{{- range $name := $selectedTrustedCasks -}}
  {{- if or (eq $cask $name) (eq $cask (last (splitList "/" $name))) -}}{{- $trustedName = $name -}}{{- end -}}
{{- end }}
cask {{ default $cask $trustedName | quote }}{{ if $trustedName }}, trusted: true{{ end }}
{{- end }}
EOF

{{ template "install-custom-packages.sh.tmpl" $plan.custom }}

{{- end }}
