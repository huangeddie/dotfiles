{{- if eq .chezmoi.os "darwin" -}}
{{- $plan := includeTemplate "resolve-packages.tmpl" . | fromJson -}}
#!/bin/bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "==> Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Homebrew reads its tap-trust allowlist from $XDG_CONFIG_HOME/homebrew/
# when XDG_CONFIG_HOME is set and ~/.homebrew/ otherwise. This script runs
# under non-login bash, which never sources .bashrc, so set it explicitly to
# match interactive shells -- otherwise the two read different files.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Share declarations (including scoped trust) between install and cleanup.
# Use a fresh Homebrew process for cleanup to avoid stale pre-upgrade dependency
# caches. packages.yaml is authoritative; cleanup retains declared dependencies.
brewfile=$(mktemp)
trap 'rm -f "$brewfile"' EXIT
cat >"$brewfile" <<'EOF'
{{- template "brewfile.tmpl" $plan.homebrew }}
EOF

echo "==> Syncing Homebrew packages via brew bundle (strict)"
brew bundle install --file="$brewfile" --no-upgrade --verbose
brew bundle cleanup --file="$brewfile" --force
rm -f "$brewfile"
trap - EXIT

{{ template "install-custom-packages.sh.tmpl" $plan.custom }}

{{- end }}
