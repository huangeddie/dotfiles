{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "==> Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Homebrew reads its tap-trust allowlist from $XDG_CONFIG_HOME/homebrew/
# when XDG_CONFIG_HOME is set and ~/.homebrew/ otherwise. This script runs
# under non-login bash, which never sources .bashrc, so set it explicitly to
# match interactive shells -- otherwise the two read different files.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Authorize third-party tap formulae. Called twice: before the bundle, which
# cannot load them otherwise, and again after, because `brew bundle --cleanup`
# prunes the allowlist and would leave interactive brew commands untrusted.
grant_tap_trust() {
{{ range .packages.darwin.trusted_formulae -}}
  brew trust --formula {{ . | quote }} >/dev/null
{{ end -}}
  :
}

grant_tap_trust

# packages.yaml is authoritative: --cleanup --force uninstalls anything
# installed that is not declared there.
echo "==> Syncing Homebrew packages via brew bundle (strict)"
brew bundle --file=/dev/stdin --cleanup --force <<EOF
{{- $blocked_prefixes := get . "blocked_prefixes" | default list -}}
{{ range .packages.darwin.taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.brews -}}
  {{- $pkg := . -}}
  {{- $blocked := false -}}
  {{- range $blocked_prefixes }}
    {{- if hasPrefix . $pkg }}
      {{- $blocked = true -}}
    {{- end }}
  {{- end }}
  {{- if not $blocked }}
brew {{ $pkg | quote }}
  {{- end }}
{{- end -}}
{{ range .packages.darwin.casks -}}
  {{- $pkg := . -}}
  {{- $blocked := false -}}
  {{- range $blocked_prefixes }}
    {{- if hasPrefix . $pkg }}
      {{- $blocked = true -}}
    {{- end }}
  {{- end }}
  {{- if not $blocked }}
cask {{ $pkg | quote }}
  {{- end }}
{{- end -}}
EOF

grant_tap_trust

{{ template "install-custom-packages.sh.tmpl" .packages.darwin.custom }}

{{- end }}
